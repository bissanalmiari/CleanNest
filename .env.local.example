# MongoDB Atlas
MONGODB_URI="mongodb+srv://<user>:<password>@cluster.mongodb.net/cleannest?retryWrites=true&w=majority"

# Auth (used to sign/verify the session JWT stored in an httpOnly cookie)
AUTH_SECRET="replace-with-a-random-secret"
AUTH_TOKEN_EXPIRES_IN="7d"

# Email (OTP delivery)
EMAIL_SERVER=""
EMAIL_FROM=""


SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_AVATAR_BUCKET="avatars"

# Booking scheduler
BUSINESS_TIME_ZONE="Asia/Beirut"
CRON_SECRET="replace-with-a-long-random-secret"
