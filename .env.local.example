# MongoDB Atlas
MONGODB_URI="mongodb+srv://<user>:<password>@cluster.mongodb.net/cleannest?retryWrites=true&w=majority"

# Auth (used to sign/verify the session JWT stored in an httpOnly cookie)
AUTH_SECRET="replace-with-a-random-secret"
AUTH_TOKEN_EXPIRES_IN="7d"

# Email (OTP and queued transactional notifications)
EMAIL_SERVER=""
EMAIL_FROM="CleanNest <notifications@yourdomain.com>"
EMAIL_REPLY_TO="support@yourdomain.com"
# Optional dedicated SMTP bounce/return-path address supplied by your provider.
EMAIL_RETURN_PATH=""
# Must normally match the authenticated From domain.
EMAIL_MESSAGE_DOMAIN="yourdomain.com"
# Optional app-level DKIM. Leave blank when your SMTP provider already signs DKIM.
EMAIL_DKIM_DOMAIN=""
EMAIL_DKIM_SELECTOR=""
EMAIL_DKIM_PRIVATE_KEY=""
APP_URL="http://localhost:3000"

# Stripe (card payments — use your test-mode keys while developing)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_AVATAR_BUCKET="avatars"
SUPABASE_REVIEW_BUCKET="review-images"
SUPABASE_SERVICE_IMAGE_BUCKET="service-images"
# Optional; defaults to SUPABASE_REVIEW_BUCKET.
SUPABASE_PROOF_BUCKET=""

# Booking scheduler
BUSINESS_TIME_ZONE="Asia/Beirut"
CRON_SECRET="replace-with-a-long-random-secret"

# Demo-only cleaner check-in bypass. Keep both false in production.
ENABLE_DEMO_CHECK_IN="false"
NEXT_PUBLIC_ENABLE_DEMO_CHECK_IN="false"
